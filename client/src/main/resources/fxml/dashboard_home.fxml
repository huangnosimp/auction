<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox spacing="16" style="-fx-background-color: #211429;" styleClass="main-content" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.io.huangnosimp.controller.dashboard_homeController">

    <VBox spacing="16" styleClass="left-panel" HBox.hgrow="ALWAYS">

        <!-- AUCTIONS CARD GRID -->
        <VBox spacing="12" styleClass="table-section" VBox.vgrow="ALWAYS">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label styleClass="section-title" text="🔥 Auctions" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnCreateAuction" mnemonicParsing="false" onAction="#handleCreateAuction" styleClass="tab-action-btn" text="+ Tạo phiên" />
            </HBox>

            <!-- Tab Bar -->
            <HBox spacing="4" styleClass="tab-bar">
                <Button fx:id="tabJoined" mnemonicParsing="false" styleClass="tab-btn tab-btn-active" text="Đang tham gia" />
                <Button fx:id="tabMyAuctions" mnemonicParsing="false" styleClass="tab-btn" text="Phiên của tôi" />
            </HBox>

            <!-- Content -->
            <ScrollPane fitToWidth="true" styleClass="auction-scroll" VBox.vgrow="ALWAYS">
                <content>
                    <FlowPane fx:id="auctionFlowPane" hgap="12" prefWrapLength="600" styleClass="auction-flow-pane" vgap="12" />
                </content>
            </ScrollPane>

        </VBox>
    </VBox>

</HBox>
