<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane prefHeight="600" prefWidth="900" style="-fx-background-color: #BA0000;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

    <!-- Left Panel - Brand / Illustration -->
    <VBox alignment="CENTER" prefWidth="420" spacing="24" style="-fx-background-color: #BA0000;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.topAnchor="0">

        <padding>
            <Insets bottom="50" left="40" right="40" top="50" />
        </padding>

        <!-- Logo Circle -->
        <StackPane alignment="CENTER">
            <Rectangle arcHeight="110" arcWidth="110" height="110" style="-fx-fill: rgba(255,255,255,0.15);" width="110" />
            <!-- Replace with actual logo ImageView if available -->
            <Label style="-fx-text-fill: white;                        -fx-font-size: 36px;                        -fx-font-weight: bold;                        -fx-font-family: 'Georgia';" text="AUCTION123" />
        </StackPane>

        <!-- University Name -->
        <Label alignment="CENTER" style="-fx-text-fill: white;                    -fx-font-size: 18px;                    -fx-font-weight: bold;                    -fx-font-family: 'Georgia';" text="ONLINE" wrapText="true" />

        <Label alignment="CENTER" style="-fx-text-fill: rgba(255,255,255,0.65);                    -fx-font-size: 10px;                    -fx-font-family: 'Trebuchet MS';" text="DAU GIA ONLINE" wrapText="true" />

        <!-- Divider -->
        <Rectangle height="2" style="-fx-fill: rgba(255,255,255,0.4);" width="60" />

        <!-- Subtitle -->
        <Label alignment="CENTER" style="-fx-text-fill: rgba(255,255,255,0.85);                    -fx-font-size: 14px;                    -fx-font-family: 'Trebuchet MS';" text="Hệ thống đấu giá trực tuyến số một Việt Nam" wrapText="true" />

        <!-- Bottom note -->
        <VBox alignment="CENTER" spacing="4">
            <padding>
                <Insets top="30" />
            </padding>
            <Label style="-fx-text-fill: rgba(255,255,255,0.45);                        -fx-font-size: 10px;                        -fx-font-family: 'Trebuchet MS';" text="" />
        </VBox>

    </VBox>

    <!-- Right Panel - Login Form -->
    <VBox alignment="CENTER" spacing="0" style="-fx-background-color: #f7f8fc;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="420" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <padding>
            <Insets bottom="0" left="60" right="60" top="0" />
        </padding>

        <!-- Header -->
        <VBox alignment="CENTER_LEFT" spacing="6">
            <Label style="-fx-text-fill: #b0b8cc;                        -fx-font-size: 12px;                        -fx-font-family: 'Trebuchet MS';" text="Chào mừng trở lại" />
            <Label style="-fx-text-fill: #BA0000;                        -fx-font-size: 28px;                        -fx-font-weight: bold;                        -fx-font-family: 'Georgia';" text="Đăng nhập" />
        </VBox>

        <!-- Spacer -->
        <VBox prefHeight="32" />

        <!-- Username Field -->
        <VBox spacing="6">
            <Label style="-fx-text-fill: #BA0000;                        -fx-font-size: 12px;                        -fx-font-weight: bold;                        -fx-font-family: 'Trebuchet MS';" text="Tên đăng nhập" />
            <TextField fx:id="usernameField" prefHeight="44" promptText="Nhập tên đăng nhập hoặc email..." style="-fx-background-color: white;                        -fx-border-color: #dde3ef;                        -fx-border-radius: 8px;                        -fx-background-radius: 8px;                        -fx-border-width: 1.5px;                        -fx-padding: 12 16 12 16;                        -fx-font-size: 13px;                        -fx-font-family: 'Trebuchet MS';                        -fx-text-fill: #2d3748;                        -fx-prompt-text-fill: #a0aec0;" />
        </VBox>

        <!-- Spacer -->
        <VBox prefHeight="16" />

        <!-- Password Field -->
        <VBox spacing="6">
            <HBox alignment="CENTER_LEFT">
                <Label style="-fx-text-fill: #BA0000;                            -fx-font-size: 12px;                            -fx-font-weight: bold;                            -fx-font-family: 'Trebuchet MS';" text="Mật khẩu" HBox.hgrow="ALWAYS" />
                <Hyperlink fx:id="forgotPasswordLink" onAction="#handleForgotPassword" style="-fx-text-fill: #BA0000;                            -fx-font-size: 11px;                            -fx-border-color: transparent;                            -fx-font-family: 'Trebuchet MS';" text="Quên mật khẩu?" />
            </HBox>
            <PasswordField fx:id="passwordField" prefHeight="44" promptText="Nhập mật khẩu..." style="-fx-background-color: white;                        -fx-border-color: #dde3ef;                        -fx-border-radius: 8px;                        -fx-background-radius: 8px;                        -fx-border-width: 1.5px;                        -fx-padding: 12 16 12 16;                        -fx-font-size: 13px;                        -fx-font-family: 'Trebuchet MS';                        -fx-text-fill: #2d3748;                        -fx-prompt-text-fill: #a0aec0;" />
        </VBox>

        <!-- Spacer -->
        <VBox prefHeight="12" />

        <!-- Remember Me -->
        <CheckBox fx:id="rememberMeCheckBox" style="-fx-text-fill: #BA0000;                    -fx-font-size: 12px;                    -fx-font-family: 'Trebuchet MS';" text="Ghi nhớ đăng nhập" />

        <!-- Error Label -->
        <Label fx:id="errorLabel" managed="false" style="-fx-text-fill: #e53e3e;                    -fx-font-size: 12px;                    -fx-font-family: 'Trebuchet MS';" text="" visible="false" wrapText="true" />

        <!-- Spacer -->
        <VBox prefHeight="24" />

        <!-- Login Button -->
        <Button fx:id="loginButton" maxWidth="Infinity" onAction="#handleLogin" prefHeight="46" style="-fx-background-color: #BA0000;                    -fx-text-fill: white;                    -fx-font-size: 13px;                    -fx-font-weight: bold;                    -fx-font-family: 'Trebuchet MS';                    -fx-background-radius: 8px;                    -fx-cursor: hand;                    -fx-effect: dropshadow(gaussian, rgba(26,58,107,0.35), 8, 0, 0, 3);" text="ĐĂNG NHẬP" />

        <!-- Spacer -->
        <VBox prefHeight="16" />

        <!-- Divider with text -->
        <HBox alignment="CENTER" spacing="12">
            <Rectangle height="1" style="-fx-fill: #BA0000;" width="80" />
            <Label style="-fx-text-fill: #a0aec0;                        -fx-font-size: 11px;                        -fx-font-family: 'Trebuchet MS';" text="hoặc" />
            <Rectangle height="1" style="-fx-fill: #BA0000;" width="80" />
        </HBox>

        <!-- Spacer -->
        <VBox prefHeight="16" />

        <!-- SSO Button -->
        <Button fx:id="ssoButton" maxWidth="Infinity" onAction="#handleRegister" prefHeight="44" style="-fx-background-color: white;                    -fx-text-fill: #BA0000;                    -fx-font-size: 13px;                    -fx-font-weight: bold;                    -fx-font-family: 'Trebuchet MS';                    -fx-background-radius: 8px;                    -fx-border-color: #BA0000;                    -fx-border-width: 1.5px;                    -fx-border-radius: 8px;                    -fx-cursor: hand;" text="Đăng ký nếu chưa có tài khoản" />

        <!-- Spacer -->
        <VBox prefHeight="32" />

        <!-- Footer -->
        <Label alignment="CENTER" maxWidth="Infinity" style="-fx-text-fill: #BA0000;                    -fx-font-size: 10px;                    -fx-font-family: 'Trebuchet MS';" text="© AUCTION123" />

    </VBox>

</AnchorPane>
