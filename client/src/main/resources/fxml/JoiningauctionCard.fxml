<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!--
    Card Type 1: Joining Auction Card
    Displayed when the user has already placed a bid in this session.
    Badge styleClass options: s-winning (currently leading) | s-outbid (been outbid)
    Controller: JoiningAuctionCardController
-->

<VBox fx:id="rootVbox" prefWidth="200.0" spacing="0" styleClass="auction-card" stylesheets="@../css/ItemCard.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.io.huangnosimp.controller.ItemCardController">

    <children>

        <!-- ===== Image Container ===== -->
        <StackPane prefHeight="130.0" styleClass="image-container">
            <children>
                <ImageView fx:id="imgProduct" fitHeight="130.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="false" />
            </children>
        </StackPane>

        <!-- ===== Card Body ===== -->
        <VBox prefWidth="200.0" spacing="10" style="-fx-padding: 12;">
            <children>

                <!-- Card type label -->
                <Label styleClass="ac-card-type-label" text="Participating" />

                <!-- Product name -->
                <Label fx:id="lblProductName" styleClass="ac-product" text="Product Name" wrapText="true" />

                <!-- Bid status badge -->
                <!-- Change styleClass to "status-badge s-winning" when leading -->
                <Label fx:id="lblBidStatus" styleClass="status-badge s-outbid" text="OUTBID" />

                <!-- Info grid: time remaining & current price -->
                <GridPane vgap="5">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="90.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>
                    <children>
                        <Label fx:id="statuslbl" styleClass="ac-key" text="Ends in:" GridPane.rowIndex="0" />
                        <Label fx:id="lblTimeRemaining" styleClass="ac-val-time" text="01h 43m" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label styleClass="ac-key" text="Current bid:" GridPane.rowIndex="1" />
                        <Label fx:id="lblCurrentBid" styleClass="ac-val-price" text="285" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    </children>
                </GridPane>

                <Separator styleClass="ac-separator" />

                <!-- Bottom row: your bid + re-bid button -->
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <children>
                        <VBox>
                            <children>
                                <Label styleClass="ac-bid-sub" text="Your bid" />
                                <Label fx:id="lblYourBid" styleClass="ac-bid-val" text="270" />
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <Button fx:id="btnBidNow" prefHeight="28.0" prefWidth="75.0" styleClass="bid-btn-primary" text="Bid Again" />
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</VBox>
