<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="openSlotsPane" spacing="0" styleClass="os-root" stylesheets="@../css/open_slots.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.io.huangnosimp.controller.OpenSlotController">

    <VBox spacing="12" styleClass="os-header">

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="os-title" text="🔥 Open Slots" />
            <Label styleClass="os-live-badge" text="LIVE" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblResultCount" styleClass="os-result-count" text="Showing 6 of 24 auctions" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10">

            <HBox alignment="CENTER_LEFT" spacing="6" styleClass="os-search-box" HBox.hgrow="ALWAYS">
                <Label styleClass="os-search-icon" text="🔍" />
                <TextField fx:id="txtSearch" promptText="Search auctions, items…" styleClass="os-search-field" HBox.hgrow="ALWAYS" />
            </HBox>
         <Button mnemonicParsing="false" style="-fx-background-color: #1e2029; -fx-border-color: #3a3f56; -fx-border-radius: 8px;" text="Search" textFill="WHITE" />

            <HBox alignment="CENTER_LEFT" spacing="6" styleClass="os-filter-group" />
        </HBox>

    </VBox>

    <ScrollPane fx:id="scrollPane" fitToWidth="true" styleClass="os-scroll" VBox.vgrow="ALWAYS">

        <FlowPane fx:id="cardContainer" hgap="14" styleClass="os-flow-pane" vgap="14" />

    </ScrollPane>

    <HBox alignment="CENTER" styleClass="os-footer">
        <Button fx:id="btnShowMore" onAction="#loadMorePublicCards" styleClass="os-show-more-btn" text="Show More  ↓" />
    </HBox>

</VBox>
