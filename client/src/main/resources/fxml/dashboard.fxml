                                        <VBox spacing="4" style="-fx-background-color: #1a1824; -fx-padding: 8; -fx-background-radius: 6; -fx-border-color: rgba(255,204,68,0.15); -fx-border-width: 1;">
                                            <HBox alignment="CENTER_LEFT">
                                                <Label maxWidth="120" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #f0eeff;" text="MacBook Pro M3 Max" HBox.hgrow="ALWAYS" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label style="-fx-font-size: 11px; -fx-text-fill: #ffcc44; -fx-font-weight: bold;" text="05m 50s" />
                                            </HBox>
                                            <ProgressBar maxWidth="Infinity" prefHeight="3.0" progress="0.55" style="-fx-accent: #ffcc44;" />
                                        </VBox>

                                        <VBox spacing="4" style="-fx-background-color: #1a1824; -fx-padding: 8; -fx-background-radius: 6; -fx-border-color: rgba(255,204,68,0.15); -fx-border-width: 1;">
                                            <HBox alignment="CENTER_LEFT">
                                                <Label maxWidth="120" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #f0eeff;" text="Leica M11 Camera" HBox.hgrow="ALWAYS" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label style="-fx-font-size: 11px; -fx-text-fill: #ffcc44; -fx-font-weight: bold;" text="08m 20s" />
                                            </HBox>
                                            <ProgressBar maxWidth="Infinity" prefHeight="3.0" progress="0.78" style="-fx-accent: #ffcc44;" />
                                        </VBox>

                                        <VBox spacing="4" style="-fx-background-color: #1a1824; -fx-padding: 8; -fx-background-radius: 6; -fx-border-color: rgba(255,204,68,0.15); -fx-border-width: 1;">
                                            <HBox alignment="CENTER_LEFT">
                                                <Label maxWidth="120" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #f0eeff;" text="Sony WH-1000XM5" HBox.hgrow="ALWAYS" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label style="-fx-font-size: 11px; -fx-text-fill: #ffcc44; -fx-font-weight: bold;" text="11m 05s" />
                                            </HBox>
                                            <ProgressBar maxWidth="Infinity" prefHeight="3.0" progress="0.91" style="-fx-accent: #ffcc44;" />
                                        </VBox>

                                    </VBox>
                                </content>
                            </ScrollPane>
                        </VBox>

                    </VBox>
                </AnchorPane>
            </left>

        </BorderPane>

        <VBox fx:id="toastContainer" alignment="TOP_RIGHT" maxWidth="400" mouseTransparent="true" pickOnBounds="false" StackPane.alignment="TOP_RIGHT">
            <padding>
                <Insets right="20" top="80" />
            </padding>
            <children>
                <HBox fx:id="toastBox" alignment="CENTER_LEFT" managed="false" spacing="10" style="-fx-background-color: #1a2e1a; -fx-border-color: #22c55e; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 10, 0, 0, 4);" visible="false">
                    <padding><Insets bottom="12" left="14" right="16" top="12" /></padding>
                    <children>
                        <StackPane prefHeight="22" prefWidth="22">
                            <children>
                                <Circle fx:id="toastIconCircle" fill="#22c55e" radius="11" StackPane.alignment="CENTER" />
                                <Label fx:id="toastIconLabel" style="-fx-text-fill: #0a2a0a; -fx-font-size: 11px; -fx-font-weight: bold;" text="✓" StackPane.alignment="CENTER" />
                            </children>
                        </StackPane>
                        <VBox spacing="2">
                            <children>
                                <Label fx:id="toastTitle" style="-fx-text-fill: #4ade80; -fx-font-size: 12px; -fx-font-weight: bold;" text="Thành công!" />
                                <Label fx:id="toastSub" style="-fx-text-fill: #86efac; -fx-font-size: 10px;" text="" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

    </children>
</StackPane>
