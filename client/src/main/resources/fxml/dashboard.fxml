                                                <Label maxWidth="120" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #f0eeff;" text="Mechanical Keyboard" HBox.hgrow="ALWAYS" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label style="-fx-font-size: 11px; -fx-text-fill: #ffcc44; -fx-font-weight: bold;" text="03m 12s" />
                                            </HBox>
                                            <ProgressBar maxWidth="Infinity" prefHeight="3.0" progress="0.32" style="-fx-accent: #ffcc44;" />
