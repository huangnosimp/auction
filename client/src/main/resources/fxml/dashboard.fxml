<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane fx:id="rootStack" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.io.huangnosimp.controller.DashboardController">
    <children>

        <BorderPane fx:id="mainBorderPane" styleClass="root-pane">

            <top>
                <HBox alignment="CENTER_LEFT" spacing="0" styleClass="navbar">
                    <HBox alignment="CENTER_LEFT" spacing="4" styleClass="logo-container">
                        <Label styleClass="logo-ofc" text="E-Auctio." />
                        <Label styleClass="logo-digital" text="Realtime" />
                    </HBox>

                    <HBox fx:id="menuHbox" alignment="CENTER_LEFT" spacing="4" styleClass="nav-buttons" HBox.hgrow="ALWAYS">
                        <Button fx:id="btnDashboard" onAction="#handlebtnDashboard" styleClass="nav-btn, nav-btn-active" text="Dashboard" />
                        <Button fx:id="btnOpenSlots" onAction="#handlebtnOpenSlots" styleClass="nav-btn" text="Open Slots" />
                        <Button fx:id="btnInventory" onAction="#handlebtnInventory" styleClass="nav-btn" text="Inventory" />
                    </HBox>

                    <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="nav-right">
                        <Button fx:id="btnSupport" styleClass="support-btn" text="⊕  Personal Support" />
                        <Button fx:id="btnNotif" styleClass="icon-btn" text="🔔" />
                        <Button fx:id="btnAvatar" onAction="#handlebtnAvatar" styleClass="avatar-btn">
                            <graphic>
                                <Label styleClass="avatar-label" text="👤" />
                            </graphic>
                        </Button>
                    </HBox>
                </HBox>
            </top>

            <center>
                <StackPane fx:id="contentArea" prefWidth="697.0">
                    <fx:include source="dashboard_home.fxml" />
                </StackPane>
            </center>

            <left>
                <AnchorPane fx:id="side" prefHeight="693.0" prefWidth="311.0" styleClass="sidebar-container" BorderPane.alignment="CENTER">
                    <VBox fx:id="sideVbox" spacing="14" AnchorPane.bottomAnchor="12" AnchorPane.leftAnchor="12" AnchorPane.rightAnchor="12" AnchorPane.topAnchor="12">

                        <VBox spacing="4" styleClass="stat-card">
                            <Label styleClass="stat-label" text="YOUR BALANCE" />
                            <Label fx:id="lblBalance" styleClass="stat-value" text="1,550" />
                            <Label fx:id="lblBalanceChange" managed="false" styleClass="balance-change" text="" visible="false" />
                        </VBox>

                        <SplitPane dividerPositions="0.4" orientation="VERTICAL" styleClass="sidebar-split-pane" VBox.vgrow="ALWAYS">
                            <items>

                                <VBox prefHeight="230.0" spacing="8" styleClass="side-card, side-card-outbid">
                                    <HBox alignment="CENTER_LEFT" spacing="6">
                                        <Label styleClass="side-title-outbid" text="🚨 OUTBID ALERTS" />
                                        <Label fx:id="outbidBadge" styleClass="side-badge-outbid" text="0" />
                                    </HBox>

                                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="side-scroll" vbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                                        <content>
                                            <VBox fx:id="outbidAlertsList" spacing="8" styleClass="side-list-container">

                                                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="outbid-item-row">
                                                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                        <Label styleClass="side-item-title" text="iPhone 15 Pro Max" />
                                                        <Label styleClass="side-item-value-outbid" text="Top: $1,600" />
                                                    </VBox>
                                                    <Button styleClass="side-quick-bid-btn" text="Bid +1" />
                                                </HBox>

                                                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="outbid-item-row">
                                                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                        <Label styleClass="side-item-title" text="RTX 4090 ROG Strix" />
                                                        <Label styleClass="side-item-value-outbid" text="Top: $2,150" />
                                                    </VBox>
                                                    <Button styleClass="side-quick-bid-btn" text="Bid +1" />
                                                </HBox>

                                                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="outbid-item-row">
                                                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                        <Label styleClass="side-item-title" text="Keychron Q1 Pro" />
                                                        <Label styleClass="side-item-value-outbid" text="Top: $180" />
                                                    </VBox>
                                                    <Button styleClass="side-quick-bid-btn" text="Bid +1" />
                                                </HBox>

                                                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="outbid-item-row">
                                                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                        <Label styleClass="side-item-title" text="AirPods Pro Gen 2" />
                                                        <Label styleClass="side-item-value-outbid" text="Top: $210" />
                                                    </VBox>
                                                    <Button styleClass="side-quick-bid-btn" text="Bid +1" />
                                                </HBox>

                                                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="outbid-item-row">
                                                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                        <Label styleClass="side-item-title" text="PlayStation 5 Slim" />
                                                        <Label styleClass="side-item-value-outbid" text="Top: $450" />
                                                    </VBox>
                                                    <Button styleClass="side-quick-bid-btn" text="Bid +1" />
                                                </HBox>

                                            </VBox>
                                        </content>
                                    </ScrollPane>
                                </VBox>

                                <VBox spacing="8" styleClass="side-card, side-card-autobid">
                                    <HBox alignment="CENTER_LEFT" spacing="6">
                                        <Label styleClass="side-title-autobid" text="🤖 AUTO BID ACTIVE" />
                                        <Label fx:id="autoBidBadge" styleClass="side-badge-autobid" text="0" />
                                    </HBox>

                                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="side-scroll" vbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                                        <content>
                                            <VBox fx:id="autoBidList" spacing="8" styleClass="side-list-container" />
                                        </content>
                                    </ScrollPane>
                                </VBox>

                            </items>
                        </SplitPane>

                    </VBox>
                </AnchorPane>
            </left>

        </BorderPane>

        <VBox fx:id="toastContainer" alignment="TOP_RIGHT" maxWidth="400" mouseTransparent="true" pickOnBounds="false" StackPane.alignment="TOP_RIGHT">
            <padding>
                <Insets right="20" top="80" />
            </padding>
            <children>
                <HBox fx:id="toastBox" alignment="CENTER_LEFT" managed="false" spacing="10" styleClass="toast-box" visible="false">
                    <padding><Insets bottom="12" left="14" right="16" top="12" /></padding>
                    <children>
                        <StackPane prefHeight="22" prefWidth="22">
                            <children>
                                <Circle fx:id="toastIconCircle" radius="11" styleClass="toast-circle" StackPane.alignment="CENTER" />
                                <Label fx:id="toastIconLabel" styleClass="toast-icon-text" text="✓" StackPane.alignment="CENTER" />
                            </children>
                        </StackPane>
                        <VBox spacing="2">
                            <children>
                                <Label fx:id="toastTitle" styleClass="toast-title-text" text="Thành công!" />
                                <Label fx:id="toastSub" styleClass="toast-sub-text" text="" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

    </children>
</StackPane>
