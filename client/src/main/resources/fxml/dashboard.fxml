<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane fx:id="rootStack" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.io.huangnosimp.controller.DashboardController">
    <children>

        <BorderPane fx:id="mainBorderPane" styleClass="root-pane">

            <top>
                <HBox alignment="CENTER_LEFT" spacing="0" styleClass="navbar">
                    <HBox alignment="CENTER_LEFT" spacing="4" styleClass="logo-container">
                        <Label styleClass="logo-ofc" text="HOANGCHIM88." />
                        <Label styleClass="logo-digital" text="Digital" />
                    </HBox>

                    <HBox fx:id="menuHbox" alignment="CENTER_LEFT" spacing="4" styleClass="nav-buttons" HBox.hgrow="ALWAYS">
                        <Button fx:id="btnDashboard" onAction="#handlebtnDashboard" styleClass="nav-btn, nav-btn-active" text="Dashboard" />
                        <Button fx:id="btnOpenSlots" onAction="#handlebtnOpenSlots" styleClass="nav-btn" text="Open Slots" />
                        <Button fx:id="btnInventory" onAction="#handlebtnInventory" styleClass="nav-btn" text="Inventory" />
                    </HBox>

                    <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="nav-right">
                        <Button fx:id="btnSupport" styleClass="support-btn" text="⊕  Personal Support" />
                        <Button fx:id="btnNotif" styleClass="icon-btn" text="🔔" />
                        <Button fx:id="btnAvatar" onAction="#handlebtnAvatar" styleClass="avatar-btn">
                            <graphic>
                                <Label styleClass="avatar-label" text="👤" />
                            </graphic>
                        </Button>
                    </HBox>
                </HBox>
            </top>

            <center>
                <StackPane fx:id="contentArea" prefWidth="697.0">
                    <fx:include source="dashboard_home.fxml" />
                </StackPane>
            </center>

            <left>
                <AnchorPane fx:id="side" prefHeight="693.0" prefWidth="332.0" style="-fx-background-color: #12111a; -fx-border-color: transparent #2a2640 transparent transparent; -fx-border-width: 1;" BorderPane.alignment="CENTER">
