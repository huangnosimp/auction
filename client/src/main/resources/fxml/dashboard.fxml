                        <VBox spacing="4" styleClass="stat-card">
                            <Label styleClass="stat-label" text="YOUR BALANCE" />
                            <Label fx:id="lblBalance" styleClass="stat-value" text="1,550" />
                            <Label styleClass="stat-link" text="+ Top Up" />
                        </VBox>

                        <VBox prefHeight="230.0" spacing="8" style="-fx-padding: 12;" styleClass="side-card">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label style="-fx-text-fill: #ff6b6b; -fx-font-size: 11px; -fx-font-weight: bold; -fx-letter-spacing: 0.5px;" text="🚨 OUTBID ALERTS" />
                                <Label style="-fx-background-color: #ff3333; -fx-text-fill: white; -fx-font-size: 9px; -fx-font-weight: bold; -fx-background-radius: 4; -fx-padding: 1 5 1 5;" text="5" />
                            </HBox>

                            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" vbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                                <content>
                                    <VBox fx:id="outbidAlertsList" spacing="8" style="-fx-background-color: transparent;">

                                        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: #1a1515; -fx-padding: 8; -fx-background-radius: 6; -fx-border-color: rgba(255,51,51,0.2); -fx-border-width: 1;">
                                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #f0eeff;" text="iPhone 15 Pro Max" />
                                                <Label style="-fx-font-size: 11px; -fx-text-fill: #ff6b6b;" text="Top: $1,600" />
                                            </VBox>
                                            <Button style="-fx-background-color: #ff3333; -fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold; -fx-background-radius: 4; -fx-padding: 4 8 4 8; -fx-cursor: hand;" text="Bid +1" />
                                        </HBox>

                                        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: #1a1515; -fx-padding: 8; -fx-background-radius: 6; -fx-border-color: rgba(255,51,51,0.2); -fx-border-width: 1;">
                                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #f0eeff;" text="RTX 4090 ROG Strix" />
                                                <Label style="-fx-font-size: 11px; -fx-text-fill: #ff6b6b;" text="Top: $2,150" />
                                            </VBox>
                                            <Button style="-fx-background-color: #ff3333; -fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold; -fx-background-radius: 4; -fx-padding: 4 8 4 8; -fx-cursor: hand;" text="Bid +1" />
                                        </HBox>

                                        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: #1a1515; -fx-padding: 8; -fx-background-radius: 6; -fx-border-color: rgba(255,51,51,0.2); -fx-border-width: 1;">
                                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #f0eeff;" text="Keychron Q1 Pro" />
                                                <Label style="-fx-font-size: 11px; -fx-text-fill: #ff6b6b;" text="Top: $180" />
                                            </VBox>
                                            <Button style="-fx-background-color: #ff3333; -fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold; -fx-background-radius: 4; -fx-padding: 4 8 4 8; -fx-cursor: hand;" text="Bid +1" />
                                        </HBox>

                                        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: #1a1515; -fx-padding: 8; -fx-background-radius: 6; -fx-border-color: rgba(255,51,51,0.2); -fx-border-width: 1;">
                                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #f0eeff;" text="AirPods Pro Gen 2" />
                                                <Label style="-fx-font-size: 11px; -fx-text-fill: #ff6b6b;" text="Top: $210" />
                                            </VBox>
                                            <Button style="-fx-background-color: #ff3333; -fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold; -fx-background-radius: 4; -fx-padding: 4 8 4 8; -fx-cursor: hand;" text="Bid +1" />
                                        </HBox>

                                        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: #1a1515; -fx-padding: 8; -fx-background-radius: 6; -fx-border-color: rgba(255,51,51,0.2); -fx-border-width: 1;">
                                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #f0eeff;" text="PlayStation 5 Slim" />
                                                <Label style="-fx-font-size: 11px; -fx-text-fill: #ff6b6b;" text="Top: $450" />
                                            </VBox>
                                            <Button style="-fx-background-color: #ff3333; -fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold; -fx-background-radius: 4; -fx-padding: 4 8 4 8; -fx-cursor: hand;" text="Bid +1" />
                                        </HBox>

                                    </VBox>
                                </content>
                            </ScrollPane>
                        </VBox>

                        <VBox spacing="8" style="-fx-padding: 12;" styleClass="side-card" VBox.vgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label style="-fx-text-fill: #ffcc44; -fx-font-size: 11px; -fx-font-weight: bold; -fx-letter-spacing: 0.5px;" text="⏳ CLOSING SOON" />
                            </HBox>

                            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" vbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                                <content>
                                    <VBox fx:id="closingSoonList" spacing="8" style="-fx-background-color: transparent;">

                                        <VBox spacing="4" style="-fx-background-color: #1a1824; -fx-padding: 8; -fx-background-radius: 6; -fx-border-color: rgba(255,204,68,0.15); -fx-border-width: 1;">
                                            <HBox alignment="CENTER_LEFT">
                                                <Label maxWidth="120" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #f0eeff;" text="Vincent van Gogh Art" HBox.hgrow="ALWAYS" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label style="-fx-font-size: 11px; -fx-text-fill: #ffcc44; -fx-font-weight: bold;" text="01m 45s" />
                                            </HBox>
                                            <ProgressBar maxWidth="Infinity" prefHeight="3.0" progress="0.15" style="-fx-accent: #ffcc44;" />
