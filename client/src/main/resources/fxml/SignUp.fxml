<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="700.0" prefWidth="800.0" stylesheets="@../css/login.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.io.huangnosimp.controller.SignUpController">
    <children>
        <VBox alignment="CENTER" maxWidth="450.0" spacing="20.0" styleClass="login-card">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <children>
                <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="logo-text" text="AUCTION88." />

                <VBox spacing="5.0">
                    <children>
                        <Label styleClass="label-bright" text="Create Account" />
                        <Label styleClass="label-dim" text="Join our bidding community today" />
                    </children>
                </VBox>

                <VBox spacing="12.0">
                    <children>
                        <TextField fx:id="fullNameField" onAction="#handleFullNameEnter" promptText="Full Name" styleClass="input-field" />
                        <TextField fx:id="userNameField" onAction="#handleUserNameEnter" promptText="User Name" styleClass="input-field" />
                        <TextField fx:id="emailField" onAction="#handleEmailEnter" promptText="Email Address" styleClass="input-field" />
                        
                        <StackPane>
                            <children>
                                <PasswordField fx:id="passwordField" onAction="#handlePasswordEnter" promptText="Password" styleClass="input-field" />
                                <TextField fx:id="passwordTextField" onAction="#handlePasswordEnter" promptText="Password" styleClass="input-field" visible="false" managed="false" />
                            </children>
                        </StackPane>

                        <StackPane>
                            <children>
                                <PasswordField fx:id="confirmPasswordField" onAction="#handleConfirmPasswordEnter" promptText="Confirm Password" styleClass="input-field" />
                                <TextField fx:id="confirmPasswordTextField" onAction="#handleConfirmPasswordEnter" promptText="Confirm Password" styleClass="input-field" visible="false" managed="false" />
                            </children>
                        </StackPane>
                        
                        <CheckBox fx:id="showPasswordCheck" onAction="#togglePasswordVisibility" text="Show Password" />
                    </children>
                </VBox>

                <CheckBox fx:id="termsCheckBox" mnemonicParsing="false" styleClass="label-dim" text="I agree to the Terms &amp; Conditions" />

                <Button fx:id="signUpButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleSignUp" styleClass="primary-button" text="CREATE ACCOUNT" />

                <HBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label styleClass="label-dim" text="Already have an account?" />
                        <Label onMouseClicked="#navigateToLogin" styleClass="link-text" text="Login here" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
