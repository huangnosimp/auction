<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!--
    Card Type 3: Public Auction Card (browse / discovery view)
    Displayed for auction sessions the user has not yet joined.
    Instead of "Your bid", shows the number of active bidders.
    The "Join" button registers the user and enters the session for the first time.
    Controller: PublicAuctionCardController
-->

<VBox fx:id="rootVbox" prefHeight="326.0" prefWidth="205.0" spacing="0" styleClass="auction-card" stylesheets="@../css/ItemCard.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.io.huangnosimp.controller.ItemCardController">

    <children>

        <StackPane prefHeight="100.0" styleClass="image-container">
            <children>
                <ImageView fx:id="imgProduct" fitHeight="100.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="false" />

                <Label fx:id="lblTag" styleClass="img-tag-badge" text="New" StackPane.alignment="TOP_LEFT" />
            </children>
        </StackPane>

        <VBox prefWidth="150.0" spacing="7" style="-fx-padding: 9;">
            <children>

                <Label styleClass="ac-card-type-label" text="Available" />

                <Label fx:id="lblProductName" styleClass="ac-product" text="Product Name" wrapText="true" />

                <Label fx:id="lblAuctionStatus" styleClass="status-badge s-open" text="OPEN" />

                <GridPane vgap="4">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="70.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>
                    <children>
                        <Label fx:id="statuslbl" styleClass="ac-key" text="Ends in:" GridPane.rowIndex="0" />
                        <Label fx:id="lblTimeRemaining" styleClass="ac-val-time" text="11h 05m" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label styleClass="ac-key" text="Current bid:" GridPane.rowIndex="1" />
                        <Label fx:id="lblCurrentBid" styleClass="ac-val-price" text="82" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    </children>
                </GridPane>

                <Separator styleClass="ac-separator" />

                <HBox alignment="CENTER_LEFT" spacing="4">
                    <children>
                        <VBox>
                            <children>
                                <Label prefHeight="16.0" prefWidth="84.0" styleClass="ac-bid-sub" text="Active bidders" />
                                <Label fx:id="lblBidderCount" styleClass="ac-bid-val" text="5 people" />
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <Button fx:id="btnJoin" maxWidth="78.0" minWidth="55.0" onAction="#handleBidNowbutton" prefHeight="28.0" prefWidth="78.0" style="-fx-padding: 4 6 4 6;" styleClass="bid-btn-primary" text="Join Now" />
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</VBox>
