<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!--
    Card Type 3: Public Auction Card (browse / discovery view)
    Displayed for auction sessions the user has not yet joined.
    Instead of "Your bid", shows the number of active bidders.
    The "Join" button registers the user and enters the session for the first time.
    Controller: PublicAuctionCardController
-->

<VBox fx:id="rootVbox" prefWidth="200.0" spacing="0" styleClass="auction-card" stylesheets="@../css/ItemCard.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.io.huangnosimp.controller.ItemCardController">

    <children>

        <!-- ===== Image Container ===== -->
        <StackPane prefHeight="130.0" styleClass="image-container">
            <children>
                <ImageView fx:id="imgProduct" fitHeight="130.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="false" />

                <!-- Corner tag: highlight label e.g. "New" / "Ending Soon" -->
                <Label fx:id="lblTag" styleClass="img-tag-badge" text="New" StackPane.alignment="TOP_LEFT" />
            </children>
        </StackPane>

        <!-- ===== Card Body ===== -->
        <VBox prefWidth="200.0" spacing="10" style="-fx-padding: 12;">
            <children>

                <!-- Card type label -->
                <Label styleClass="ac-card-type-label" text="Available" />

                <!-- Product name -->
                <Label fx:id="lblProductName" styleClass="ac-product" text="Product Name" wrapText="true" />

                <!-- Session status badge -->
                <!-- styleClass options: s-open | s-hot | s-closing-soon -->
                <Label fx:id="lblAuctionStatus" styleClass="status-badge s-open" text="OPEN" />

                <!-- Info grid: time remaining & current price -->
                <GridPane vgap="5">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="90.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>
                    <children>
                        <Label fx:id="statuslbl" styleClass="ac-key" text="Ends in:" GridPane.rowIndex="0" />
                        <Label fx:id="lblTimeRemaining" styleClass="ac-val-time" text="11h 05m" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label styleClass="ac-key" text="Current bid:" GridPane.rowIndex="1" />
                        <Label fx:id="lblCurrentBid" styleClass="ac-val-price" text="82" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    </children>
                </GridPane>

                <Separator styleClass="ac-separator" />

                <!-- Bottom row: active bidders count + join button -->
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <children>
                        <VBox>
                            <children>
                                <Label styleClass="ac-bid-sub" text="Active bidders" />
                                <Label fx:id="lblBidderCount" styleClass="ac-bid-val" text="5 people" />
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <Button fx:id="btnJoin" prefHeight="28.0" prefWidth="75.0" styleClass="bid-btn-primary" text="Join Now" />
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</VBox>
