<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700" prefWidth="1100" stylesheets="@../css/AdminDashboard.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.io.huangnosimp.controller.AdminController">

    <left>
        <VBox prefWidth="250" spacing="15" styleClass="sidebar">
            <padding><Insets bottom="30" left="20" right="20" top="30" /></padding>

            <Label styleClass="sidebar-title" text="ADMIN PANEL" />
            <Separator styleClass="sidebar-sep" />

            <Button maxWidth="Infinity" styleClass="nav-btn, active" text="Dashboard" />
            <Button maxWidth="Infinity" styleClass="nav-btn" text="Members" />
            <Button maxWidth="Infinity" styleClass="nav-btn" text="Auctions" />

            <Region VBox.vgrow="ALWAYS" />

            <VBox spacing="10" styleClass="revenue-card">
                <Label styleClass="card-subtitle" text="SYSTEM REVENUE" />
                <Label fx:id="lblSystemRevenue" styleClass="card-value" text="\$0.00" />
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="25" styleClass="main-content">
            <padding><Insets bottom="30" left="30" right="30" top="30" /></padding>

            <Label styleClass="header-title" text="System Overview" />

            <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                <Tab text="Member Management">
                    <VBox spacing="10">
                        <padding>
                            <Insets bottom="10" left="10" right="10" top="10" />
                        </padding>

                        <TableView fx:id="tableMembers" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colMemberId" prefWidth="120" text="ID" />
                                <TableColumn fx:id="colMemberName" prefWidth="120" text="Username" />
                                <TableColumn fx:id="colMemberBalance" prefWidth="130" text="Account Balance" />
                                <TableColumn fx:id="colMemberFrozen" prefWidth="130" text="Frozen Balance" />
                                <TableColumn fx:id="colMemberStatus" prefWidth="180" text="Status" />
                            </columns>
                        </TableView>

                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label style="-fx-font-weight: bold;" text="Thời gian khóa (phút):" />
                            <TextField fx:id="txtBanDuration" prefWidth="170" promptText="Để trống = Vĩnh viễn..." />

                            <Region HBox.hgrow="ALWAYS" />

                            <Button onAction="#handleBanMember" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="Khóa (Ban)" />
                            <Button onAction="#handleUnbanMember" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" text="Mở khóa (Unban)" />
                        </HBox>
                    </VBox>
                </Tab>
                <Tab text="Auction Management">
                    <VBox spacing="10">
                        <padding>
                            <Insets bottom="10" left="10" right="10" top="10" />
                        </padding>

                        <TableView fx:id="tableAuctions" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colAuctionId" prefWidth="241.80000162124634" text="Auction ID" />
                                <TableColumn fx:id="colAuctionName" prefWidth="188.60003662109375" text="Product" />
                                <TableColumn fx:id="colAuctionPrice" prefWidth="358.39984130859375" text="Current Price" />
                            </columns>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT" spacing="15">
                            <Button onAction="#handleForceCancelAuction" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Hủy phiên đấu giá (Force Cancel)" />
                        </HBox>
                    </VBox>
                </Tab>
            </TabPane>
        </VBox>
    </center>
</BorderPane>
